# ───── DART (공시 데이터) ─────
# 발급: https://opendart.fss.or.kr  →  인증키 신청 (무료)
DART_API_KEY=여기에_DART_키

# ───── Anthropic (요약) ─────
# 발급: https://console.anthropic.com  →  API Keys
ANTHROPIC_API_KEY=여기에_Anthropic_키
SUMMARY_MODEL=claude-haiku-4-5-20251001

# ───── 이메일 발송 (Gmail 예시) ─────
# Gmail: 2단계 인증 켠 뒤 '앱 비밀번호' 발급해서 SMTP_PASS 에 입력
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=보내는메일@gmail.com
SMTP_PASS=앱비밀번호16자리
MAIL_TO=받는메일@gmail.com

# ───── 카카오톡 '나에게 보내기' (선택) ─────
# 비워두면 자동 생략. 설정법은 README 참고.
KAKAO_ACCESS_TOKEN=

# ───── 옵션 ─────
LOOKBACK_DAYS=3
# 키 없이 시험만 할 때 1 로:
MOCK_MODE=0

# ───── 네이버 검색 API (뉴스) ─────
# 발급: https://developers.naver.com → 애플리케이션 등록 → 검색 API 추가
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NEWS_ENABLED=1
NEWS_PER_STOCK=3

# ───── 보유종목 (쉼표 구분, 종목명 또는 6자리 코드) ─────
HOLDINGS=삼성전자,SK하이닉스,NAVER
